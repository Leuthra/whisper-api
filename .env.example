# Server Configuration
PORT=3000
NODE_ENV=production

# Sandbox Configuration
# Keep false for normal local/production use. Set true only for disposable demo environments.
SANDBOX_MODE=false

# Logging Configuration
LOG_LEVEL=info
PRISMA_LOG_LEVELS=warn,error


# WhatsApp Configuration
# Available modes: 'single', 'multi', 'both'
# - single: Only legacy single-instance mode
# - multi: Only multi-instance mode (default)
# - both: Both modes running simultaneously
WHATSAPP_MODE=multi

# Database
DATABASE_URL="mongodb://localhost:27017/whisper-api?replicaSet=rs0"

WELCOME_GROUP_DELAY_MS=300000
ANTI_MENTION_GROUP_JIDS=
